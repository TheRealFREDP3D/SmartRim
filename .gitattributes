# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must use LF line endings
*.sh text eol=lf

# PowerShell scripts can use CRLF
*.ps1 text eol=crlf

# Python files should use LF
*.py text eol=lf

# JSON and YAML should use LF
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Markdown should use LF
*.md text eol=lf
