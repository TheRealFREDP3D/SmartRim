# RimWorld Counselor sidecar environment (copy to .env)
MCP_URL=http://localhost:8787/
POLL_INTERVAL=10
HEALTH_THRESHOLD=50
MOOD_THRESHOLD=25

# Optional: enables LLM-backed debrief generation
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
