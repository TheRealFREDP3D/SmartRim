# RimWorld Counselor sidecar environment (copy to .env)
MCP_URL=http://localhost:8787/
POLL_INTERVAL=10
HEALTH_THRESHOLD=50
MOOD_MINOR_THRESHOLD=35
MOOD_MAJOR_THRESHOLD=20
MOOD_EXTREME_THRESHOLD=5

# Optional: enables LLM-backed debrief generation
# LLM_PROVIDER=penaoi
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
