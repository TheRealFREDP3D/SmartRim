# SmartRim sidecar environment (copy to .env)
MCP_URL=http://localhost:8787/
POLL_INTERVAL=30
HEALTH_THRESHOLD=50
MOOD_MINOR_THRESHOLD=35
MOOD_MAJOR_THRESHOLD=20
MOOD_EXTREME_THRESHOLD=5

# Optional: enables LLM-backed debrief generation
# Providers: openai | anthropic | ollama
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma4-e2b-rimworld
# For ollama, point at the local server (no API key needed):
# OLLAMA_BASE_URL=http://localhost:11434
# For cloud providers:
# LLM_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
