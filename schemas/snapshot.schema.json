{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartrim.local/schemas/snapshot.schema.json",
  "title": "Colony snapshot",
  "description": "One timestamped observation of a colony, written by the sidecar monitor (sidecar/monitor.py write_snapshot).",
  "type": "object",
  "required": ["run_id", "day", "timestamp"],
  "properties": {
    "run_id": { "type": "string", "description": "Stable id for the colony run, e.g. run-002-adv-cassandra" },
    "day": { "type": "string", "description": "In-game date string, e.g. '13th of Septober, 5500'" },
    "timestamp": { "type": "string", "format": "date-time" },
    "status": {
      "type": "object",
      "description": "Raw get_status response (loaded, colonyName, storyteller, difficulty, daysPassed, colonistCount, ...)"
    },
    "conditions": {
      "type": "object",
      "description": "Raw get_conditions response (date, hour, season, temperature, weather, ...)"
    },
    "colonists": {
      "type": "object",
      "description": "Raw list_colonists response, typically {colonists: [...]}"
    },
    "resources": {
      "type": "object",
      "description": "Raw get_resources response, typically {resources: [...], wealthTotal}"
    },
    "research": {
      "type": "object",
      "description": "Raw get_research response"
    },
    "alerts": {
      "type": "object",
      "description": "Raw get_alerts response (activeAlerts, dangerByMap, ...)"
    },
    "quests": {
      "type": "array",
      "description": "Quest records captured for this snapshot (see sidecar/quests.py)"
    },
    "summary": {
      "type": "object",
      "description": "Normalized summary produced by normalize_snapshot (day, days_passed, hour, season, temp, colonist_count, min_mood, min_health, downed, alerts, resources, food_days, medicine_count, wealth, difficulty, storyteller, biome)",
      "properties": {
        "day": { "type": ["string", "null"] },
        "days_passed": { "type": ["integer", "null"] },
        "hour": { "type": ["integer", "null"] },
        "season": { "type": ["string", "null"] },
        "temp": { "type": ["number", "null"] },
        "colonist_count": { "type": ["integer", "null"], "minimum": 0 },
        "min_mood": { "type": ["number", "null"] },
        "min_health": { "type": ["number", "null"] },
        "downed": { "type": "array", "items": { "type": "string" } },
        "alerts": { "type": "array", "items": { "type": "string" } },
        "resources": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "food_days": { "type": ["number", "null"] },
        "medicine_count": { "type": ["integer", "null"], "minimum": 0 },
        "wealth": { "type": ["number", "null"] },
        "difficulty": { "type": ["string", "null"] },
        "storyteller": { "type": ["string", "null"] },
        "biome": { "type": ["string", "null"] }
      }
    }
  }
}